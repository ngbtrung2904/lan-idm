{
  "sshUser": "user",
  "sshKeyPath": "~/.local/share/DataCollector/collector_key",
  "knownHostsPath": "~/.local/share/DataCollector/known_hosts",
  "maxParallel": 2,
  "paths": {
    "logs": ".app",
    "screenshots": "Pictures/lightshots",
    "recordings": "recordings"
  },
  "logs": {
    "includeModifiedAfterEnd": true
  },
  "ui": {
    "theme": "light"
  },
  "pcs": [
    {
      "id": "pc01",
      "host": "192.168.10.11",
      "supportsPictures": false,
      "supportsRecordings": false,
      "logSources": [
        {
          "name": "adsb-syslog",
          "remotePath": ".app/adsb/syslog",
          "destSubdir": "adsb/syslog",
          "timestampSource": "mtime"
        },
        {
          "name": "dioservice-syslog",
          "remotePath": ".app/dioservice/syslog",
          "destSubdir": "dioservice/syslog",
