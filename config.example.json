{
  "sshUser": "user",
  "sshKeyPath": "~/.ssh/collector_key",
  "knownHostsPath": "~/.local/share/DataCollector/known_hosts",
  "maxParallel": 2,
  "paths": {
    "logs": ".app",
    "screenshots": "Pictures/lightshot",
    "recordings": "recordings"
  },
  "logs": {
    "includeModifiedAfterEnd": true
  },
  "pcs": [
    { "id": "pc01", "host": "192.168.10.11" },
    { "id": "pc02", "host": "192.168.10.12" },
    { "id": "pc03", "host": "192.168.10.13" },
    { "id": "pc04", "host": "192.168.10.14" },
    { "id": "pc05", "host": "192.168.10.15" },
    { "id": "pc06", "host": "192.168.10.16" },
    {
      "id": "pc07",
      "host": "192.168.10.17",
      "supportsPictures": false,
      "supportsRecordings": false,
      "logSources": [
        {
          "name": "syslog",
          "remotePath": ".app/aesardp/syslog",
          "destSubdir": "syslog",
          "timestampSource": "filename"
        },
        {
          "name": "metadata",
          "remotePath": "app/aesardp/metadata",
          "destSubdir": "metadata",
          "timestampSource": "filename"
        }
      ]
    }
  ]
}

