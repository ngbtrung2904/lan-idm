{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$penv{HOME}/Qt/$env{QT_VERSION}/gcc_64;$penv{CMAKE_PREFIX_PATH}",
                "CMAKE_COLOR_DIAGNOSTICS" : "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "environment": {
                "QT_VERSION": "6.7.2",
                "QT_VERSION_SUFFIX": "6_7_2"
            }
        },
        {
            "name": "gcc-debug",
            "displayName": "Desktop Qt Debug (GCC, Unix Makefiles)",
            "inherits": "base",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/Desktop_Qt_$env{QT_VERSION_SUFFIX}-Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "clang-debug",
            "displayName": "Desktop Qt Debug (Clang + Mold, Ninja)",
            "inherits": "base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Desktop_Qt_$env{QT_VERSION_SUFFIX}-Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold",
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name":"static-analysis",
            "inherits":["clang-debug"],
            "cacheVariables": 
            {
                "ENABLE_CLANG_TIDY": "ON"
            }
        },
        {
            "name": "runtime-analysis",
            "inherits" : "clang-debug",
            "cacheVariables": 
                {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "RUNTIME_ANALYSIS_ARGS" : "--u",
                "ENABLE_ASAN": "OFF",
                "ENABLE_LSAN": "OFF",
                "ENABLE_MSAN": "OFF",
                "ENABLE_TSAN": "ON",
                "ENABLE_UBSAN": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc-debug",
            "configurePreset": "gcc-debug",
            "jobs": 4,
            "targets": [
                "all"
            ]
        },
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug",
            "jobs": 6,
            "targets": [
                "all"
            ]
        },
        {
            "name" : "static-analysis",
            "configurePreset": "static-analysis",
            "jobs": 8,
            "targets": ["all", "clang-tidy-html"]
        },
        {
            "name": "runtime-analysis",
            "inherits" : "gcc-debug",
            "configurePreset": "runtime-analysis",
            "targets":["run-runtime-analysis"]
        }
    ],
    "testPresets": [
        {
            "name": "gcc-debug",
            "configurePreset": "gcc-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "gcc-debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "gcc-debug"
                },
                {
                    "type": "build",
                    "name": "gcc-debug"
                }
            ]
        },
        {
            "name": "clang-debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "clang-debug"
                },
                {
                    "type": "build",
                    "name": "clang-debug"
                }
            ]
        },
        {
            "name": "static-analysis",
            "steps": 
            [
                {"type": "configure", "name":"static-analysis"},
                {"type": "build", "name":"static-analysis"}
            ]
        },
        {
            "name": "runtime-analysis",
            "steps": 
            [
                {"type": "configure", "name":"runtime-analysis"},
                {"type": "build", "name":"runtime-analysis"}
            ]
        }
    ]
}
